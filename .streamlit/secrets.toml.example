# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# Leave PayPal keys empty to run in demo mode.
PAYPAL_CLIENT_ID = "your-sandbox-client-id"
PAYPAL_CLIENT_SECRET = "your-sandbox-secret"
PAYPAL_ENV = "sandbox"

# Any one AI provider. Leave both empty to use the offline heuristic verifier.
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-5-5"
OPENAI_API_KEY = ""

# Public URL of the app, used as PayPal's return_url after the client approves.
APP_URL = "http://localhost:8501"
RELEASE_THRESHOLD = 80
